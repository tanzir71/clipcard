---
import { landingCopy, appPath } from '../languages';
import type { InterfaceLanguage } from '@clipcard/i18n';
import installIcon from '../media/hero/install.svg?url';
interface Props {
  locale: InterfaceLanguage;
}
const { locale } = Astro.props;
const strings = landingCopy(locale);

const { installApp: copy } = strings;
const app = appPath(locale);
---

<div class="app-install">
  <button class="button button-light" type="button" data-app-install>
    <img src={installIcon} width="18" height="18" alt="" />
    {copy.action}
  </button>
  <p>{copy.iosHint}</p>
  <dialog data-install-dialog aria-labelledby="install-title">
    <h2 id="install-title">{copy.heading}</h2>
    <p>{copy.offline}</p>
    <p data-install-ios>{copy.ios}</p>
    <div>
      <form method="dialog">
        <button class="button" value="cancel">
          {copy.later}
        </button>
      </form>
      <a
        class="button button-light"
        href={app}
        data-install-confirm
        data-install={copy.install}
        data-open={copy.open}
      >
        {copy.open}
      </a>
    </div>
  </dialog>
</div>

<script>
  interface InstallPrompt extends Event {
    prompt: () => Promise<void>;
    userChoice: Promise<{ outcome: 'accepted' | 'dismissed' }>;
  }
  let pending: InstallPrompt | null = null;
  window.addEventListener('beforeinstallprompt', (event) => {
    event.preventDefault();
    pending = event as InstallPrompt;
  });
  const button =
    document.querySelector<HTMLButtonElement>('[data-app-install]');
  const dialog = document.querySelector<HTMLDialogElement>(
    '[data-install-dialog]',
  );
  const confirm = document.querySelector<HTMLAnchorElement>(
    '[data-install-confirm]',
  );
  const ios = document.querySelector<HTMLElement>('[data-install-ios]');
  if (button && dialog && confirm && ios) {
    button.addEventListener('click', () => {
      if (window.matchMedia('(display-mode: standalone)').matches) {
        location.assign(confirm.href);
        return;
      }
      confirm.textContent = pending
        ? (confirm.dataset.install ?? '')
        : (confirm.dataset.open ?? '');
      ios.hidden = Boolean(pending);
      dialog.showModal();
    });
    confirm.addEventListener('click', async (event) => {
      if (!pending) return;
      event.preventDefault();
      const prompt = pending;
      pending = null;
      try {
        await prompt.prompt();
        await prompt.userChoice;
        dialog.close();
      } catch {
        location.assign(confirm.href);
      }
    });
  }
</script>
