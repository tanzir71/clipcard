---
import { landingCopy } from '../languages';
import type { InterfaceLanguage } from '@clipcard/i18n';
import CardImage from './CardImage.astro';
import '@fontsource/anek-bangla/bengali-500.css';
import '@fontsource/mukta/devanagari-500.css';
import '@fontsource/lateef/arabic-500.css';
import '@fontsource/anek-tamil/tamil-500.css';
import '@fontsource/anek-telugu/telugu-500.css';
import '@fontsource/anek-malayalam/malayalam-500.css';
import '@fontsource/anek-kannada/kannada-500.css';
import '@fontsource/anek-gujarati/gujarati-500.css';
import '@fontsource/anek-gurmukhi/gurmukhi-500.css';
import '@fontsource/anek-odia/oriya-500.css';
import '@fontsource/yaldevi/sinhala-500.css';
import '@fontsource/padauk/myanmar-400.css';
import '@fontsource/menbere/ethiopic-500.css';
import '@fontsource/cairo/arabic-500.css';
import '@fontsource/vazirmatn/arabic-500.css';
import '@fontsource/onest/cyrillic-500.css';
import '@fontsource/kanit/thai-500.css';
import '@fontsource/be-vietnam-pro/vietnamese-500.css';
import '@fontsource/be-vietnam-pro/latin-500.css';
import '@fontsource/noto-sans/latin-500.css';
import '@fontsource/noto-sans/latin-ext-500.css';
interface Props {
  locale: InterfaceLanguage;
}
const { locale } = Astro.props;
const strings = landingCopy(locale);

type Language = {
  code: keyof typeof strings.languageNames;
  font?: string;
  size?: number;
  dir?: 'rtl';
};

const languages: Language[] = [
  { code: 'bn', font: 'Anek Bangla' },
  { code: 'hi', font: 'Mukta' },
  { code: 'ur', font: 'Lateef', size: 1.3, dir: 'rtl' },
  { code: 'ne', font: 'Mukta' },
  { code: 'mr', font: 'Mukta' },
  { code: 'ta', font: 'Anek Tamil', size: 0.9 },
  { code: 'te', font: 'Anek Telugu' },
  { code: 'ml', font: 'Anek Malayalam', size: 0.9 },
  { code: 'kn', font: 'Anek Kannada' },
  { code: 'gu', font: 'Anek Gujarati' },
  { code: 'pa', font: 'Anek Gurmukhi' },
  { code: 'si', font: 'Yaldevi' },
  { code: 'id' },
  { code: 'fil' },
  { code: 'my', font: 'Padauk', size: 0.9 },
  { code: 'sw' },
  { code: 'ha', font: 'Noto Sans' },
  { code: 'yo', font: 'Noto Sans' },
  { code: 'am', font: 'Menbere' },
  { code: 'ar', font: 'Cairo', dir: 'rtl' },
  { code: 'es' },
  { code: 'pt-BR' },
  { code: 'en' },
  { code: 'fr' },
  { code: 'fa', font: 'Vazirmatn', dir: 'rtl' },
  { code: 'uk', font: 'Onest' },
  { code: 'vi', font: 'Be Vietnam Pro' },
  { code: 'th', font: 'Kanit' },
  { code: 'ms' },
  { code: 'or', font: 'Anek Odia' },
];
const localizedCards = [
  ['bn', 'header-4x5-bn'],
  ['hi', 'header-4x5-hi'],
  ['ur', 'split-4x5-ur-rtl'],
] as const;
---

<section class="section dark languages" aria-labelledby="languages-heading">
  <div class="container">
    <h2 id="languages-heading">{strings.languages}</h2>
    <ul class="language-words">
      {languages.map(({ code, font, size, dir }) => {
        return (
          <li
            lang={code}
            dir={dir}
            class:list={[code === locale && 'current-language']}
            style={
              font && {
                'font-family': `"${font}", sans-serif`,
                '--optical-size': size ?? 1,
              }
            }
          >
            {strings.languageNames[code]}
          </li>
        );
      })}
    </ul>
    <div class="language-cards">
      {localizedCards.map(([lang, name]) => (
        <CardImage
          name={name}
          alt={strings.templates.localizedExamples[lang]}
          sizes="(max-width: 767px) 240px, (max-width: 1279px) 32vw, 384px"
        />
      ))}
    </div>
  </div>
</section>
