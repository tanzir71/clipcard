---
import { appPath, homePath, landingCopy } from '../languages';
import type { InterfaceLanguage } from '@clipcard/i18n';
import BookmarkBlock from './BookmarkBlock.astro';
import CardImage from './CardImage.astro';
import HeroAppShortcut from './HeroAppShortcut.astro';
import InstallExtension from './InstallExtension.astro';
import Icon from './Icon.astro';
import Languages from './Languages.astro';
import LiveCardDemo from './LiveCardDemo.astro';
import SendToComputer from './SendToComputer.astro';
import { RELEASED, REPO_URL } from '../config';
import Site from '../layouts/Site.astro';
import { previewImage } from '../media';
import extensionPreview from '../media/feature-extension.webp?url';
import clipsPreview from '../media/feature-clips.webp?url';
import draftsPreview from '../media/feature-drafts.webp?url';
import webAppPreview from '../media/feature-web-app.webp?url';

interface Props {
  locale?: InterfaceLanguage;
}
const { locale = 'en' } = Astro.props;
const strings = landingCopy(locale);
const { nav, hero, how, features, sources, templates, faq } = strings;
const localeCard = {
  bn: 'header-4x5-bn',
  hi: 'header-4x5-hi',
  ur: 'split-4x5-ur-rtl',
} as const;
const sampleLanguage =
  locale === 'bn' || locale === 'hi' || locale === 'ur' ? locale : undefined;
const heroCards = [
  {
    name: sampleLanguage ? localeCard[sampleLanguage] : 'header-4x5-bn',
    alt: sampleLanguage
      ? templates.localizedExamples[sampleLanguage]
      : templates.localizedExamples.bn,
    order: 2,
  },
  {
    name: 'overlay-4x5',
    alt: templates.example.replace('{name}', templates.names.overlay),
    order: 4,
  },
  {
    name: 'split-4x5',
    alt: templates.example.replace('{name}', templates.names.split),
    order: 1,
  },
  {
    name: 'caps-4x5',
    alt: templates.example.replace('{name}', templates.names.caps),
    order: 3,
  },
  {
    name: 'quote-4x5',
    alt: templates.example.replace('{name}', templates.names.quote),
    order: 5,
  },
];
const howIcons = ['link', 'grid', 'qr'] as const;
const sourceIcons = ['qr', 'shield', 'edited'] as const;
const featureKeys = Object.keys(
  features.items,
) as (keyof typeof features.items)[];
const releasedPreviews = {
  clips: clipsPreview,
  drafts: draftsPreview,
};
const examples = Object.entries(templates.names).filter(
  ([name]) =>
    RELEASED.extension ||
    (RELEASED.cards ? !['duotone', 'caps'].includes(name) : name !== 'solid'),
);
const formats =
  RELEASED.cards && !RELEASED.extension
    ? ['4:5', '1:1', '9:16']
    : ['4:5', '1:1', '9:16', '16:9', '1.91:1'];
const url = new URL(homePath(locale), Astro.site).href;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: strings.brand,
    description: strings.description,
    applicationCategory: 'BrowserApplication',
    operatingSystem: 'Chrome',
    url,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(({ question, answer }) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: strings.brand,
    url,
    sameAs: [REPO_URL],
  },
];
---

<Site schema={schema} locale={locale} localizedPage="home">
  <section class="hero dark" aria-labelledby="page-heading">
    <div class="container hero-copy">
      <h1 id="page-heading">
        {RELEASED.videoJoin
          ? hero.videoHeading
          : RELEASED.app
            ? hero.appHeading
            : hero.heading}
      </h1>
      <p>
        {RELEASED.videoJoin
          ? hero.videoDescription
          : RELEASED.app
            ? hero.appDescription
            : hero.description}
      </p>
      {RELEASED.app ? (
        <HeroAppShortcut locale={locale} />
      ) : (
        <a class="button button-light hero-follow" href={REPO_URL}>
          {nav.follow}
        </a>
      )}
      <SendToComputer locale={locale} />
      {RELEASED.app ? (
        <p class="hero-beta hero-beta-mobile">{strings.installApp.heroBeta}</p>
      ) : null}
    </div>
    <ul class="hero-cards" aria-label={hero.gallery} tabindex="0">
      {heroCards.map((card) => (
        <li
          style={{ '--mobile-order': card.order }}
          data-hero-output={RELEASED.app && card.order === 1 ? '' : undefined}
        >
          <CardImage
            name={card.name}
            alt={card.alt}
            sizes="(max-width: 767px) 236px, 336px"
            eager={card.order === 1}
            priority={card.order === 1}
          />
        </li>
      ))}
    </ul>
  </section>

  <section
    class="section container"
    id="how-it-works"
    aria-labelledby="how-heading"
  >
    <h2 id="how-heading">{how.heading}</h2>
    <ul class="how-grid">
      {how.items.map(({ title, description }, index) => (
        <li>
          <span class="how-icon">
            <Icon name={howIcons[index]!} />
          </span>
          <h3>{title}</h3>
          <p>{description}</p>
        </li>
      ))}
    </ul>
  </section>

  <section
    class="section container features"
    aria-labelledby="features-heading"
  >
    <h2 id="features-heading">{features.heading}</h2>
    <ul class="features-grid">
      {featureKeys.map((key) => (
        <li class:list={[!RELEASED[key] && 'feature-soon']}>
          <img
            src={
              key === 'cards' && RELEASED.cards
                ? RELEASED.extension
                  ? extensionPreview
                  : webAppPreview
                : (key === 'clips' || key === 'drafts') && RELEASED[key]
                  ? releasedPreviews[key]
                  : previewImage(`feature-${key}`)
            }
            alt=""
            width="384"
            height="280"
            loading="lazy"
            decoding="async"
          />
          <h3>
            {features.items[key].title}{' '}
            {!RELEASED[key] && <span>{features.soon}</span>}
          </h3>
          <p>
            {key === 'cards' && RELEASED.cards && !RELEASED.extension
              ? features.appCards
              : features.items[key].description}
          </p>
        </li>
      ))}
    </ul>
    <p class="features-also">{features.also}</p>
  </section>

  {RELEASED.extension ? <InstallExtension locale={locale} /> : null}
  {RELEASED.lite ? <BookmarkBlock locale={locale} /> : null}

  <section class="section verifiable" aria-labelledby="sources-heading">
    <div class="container">
      <div>
        <h2 id="sources-heading">{sources.heading}</h2>
        <ul>
          {sources.bullets.map((bullet, index) => (
            <li>
              <Icon name={sourceIcons[index]!} />
              {bullet}
            </li>
          ))}
        </ul>
      </div>
      <figure>
        <div class="source-card">
          <CardImage
            name="split-4x5"
            alt={templates.example.replace('{name}', templates.names.split)}
            sizes="(max-width: 767px) 240px, 420px"
          />
        </div>
        <figcaption>{sources.scan}</figcaption>
      </figure>
    </div>
  </section>

  <section
    class="section container template-section"
    id="templates"
    data-clipcard-demo={RELEASED.cards ? '' : undefined}
    aria-labelledby="templates-heading"
  >
    <div class="template-heading">
      <h2 id="templates-heading">
        {RELEASED.extension
          ? templates.extensionHeading
          : RELEASED.cards
            ? templates.appHeading
            : templates.heading}
      </h2>
      <ul class="formats" aria-label={templates.formats}>
        {formats.map((format) => (
          <li>
            {RELEASED.cards ? (
              <button
                type="button"
                data-format={format}
                aria-pressed={format === '4:5'}
              >
                {format}
              </button>
            ) : (
              format
            )}
          </li>
        ))}
      </ul>
    </div>
    <div
      class:list={[
        'templates-grid',
        RELEASED.extension && 'templates-extension',
      ]}
    >
      {examples.map(([name, label]) => (
        <figure>
          <div data-demo-card={RELEASED.cards ? name : undefined}>
            <CardImage
              name={`${name}-4x5`}
              alt={templates.example.replace('{name}', label)}
              sizes="(max-width: 767px) 45vw, (max-width: 1279px) 16vw, 188px"
            />
          </div>
          <figcaption>{label}</figcaption>
        </figure>
      ))}
    </div>
    {RELEASED.cards ? <LiveCardDemo /> : null}
  </section>

  <Languages locale={locale} />

  <section class="section container faq" id="faq" aria-labelledby="faq-heading">
    <h2 id="faq-heading">{nav.faq}</h2>
    <div>
      {faq.map(({ question, answer }, index) => (
        <details open={index === 0}>
          <summary>{question}</summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="cta-band" aria-labelledby="cta-heading">
    <div class="container">
      <h2 id="cta-heading">{RELEASED.app ? strings.appBand : strings.band}</h2>
      <a
        class:list={['button button-light', RELEASED.app ? '' : 'desktop-cta']}
        href={RELEASED.app ? appPath(locale) : REPO_URL}
      >
        {RELEASED.app ? strings.shortcut.open : nav.follow}
      </a>
      {RELEASED.app ? null : <SendToComputer icon={false} locale={locale} />}
    </div>
  </section>
</Site>
