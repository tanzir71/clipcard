---
import { dirFor } from '@clipcard/core';
import type { InterfaceLanguage } from '@clipcard/i18n';
import {
  alternates,
  appPath,
  homePath,
  landingCopy,
  landingLocales,
  localizedPath,
  ogLocale,
} from '../languages';
import type { LocalizedPage } from '../languages';
import geist from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import mark from '../../../../design/brand/mark.svg?url';
import { RELEASED, REPO_URL } from '../config';
import Icon from '../components/Icon.astro';
import { socialImage } from '../media';
import { sitePath } from '../site';
import '@clipcard/cards/tokens.css';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  schema?: object[];
  noindex?: boolean;
  locale?: InterfaceLanguage;
  localizedPage?: LocalizedPage;
}
const { locale = 'en', localizedPage } = Astro.props;
const strings = landingCopy(locale);
const home = homePath(locale);
const {
  title = strings.title,
  description = strings.description,
  path = '',
  schema = [],
  noindex = false,
} = Astro.props;
const canonical = new URL(
  localizedPage ? localizedPath(locale, localizedPage) : sitePath(path),
  Astro.site,
);
const languageOptions = alternates(localizedPage ?? 'home', Astro.site).filter(
  ({ lang }) => lang !== 'x-default',
);
const alternateLinks = localizedPage
  ? alternates(localizedPage, Astro.site)
  : [
      { lang: 'en', url: canonical },
      { lang: 'x-default', url: canonical },
    ];
const navHref = (anchor: string) =>
  anchor === 'app/' ? appPath(locale) : homePath(locale, anchor);
const ogImage = new URL(socialImage(locale), Astro.site);
const navLinks: [string, string][] = [
  [strings.nav.templates, '#templates'],
  [strings.nav.how, '#how-it-works'],
  [strings.nav.faq, '#faq'],
];
if (RELEASED.app) navLinks.unshift([strings.nav.app, 'app/']);
---

<!doctype html>
<html lang={locale} dir={dirFor(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {alternateLinks.map(({ lang, url }) => (
      <link rel="alternate" hreflang={lang} href={url} />
    ))}
    <link rel="icon" type="image/svg+xml" href={mark} />
    {RELEASED.pwa ? (
      <link rel="manifest" href={sitePath('app/manifest.webmanifest')} />
    ) : null}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={geist}
      crossorigin="anonymous"
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale(locale)} />
    {localizedPage &&
      landingLocales
        .filter((lang) => lang !== locale)
        .map((lang) => (
          <meta property="og:locale:alternate" content={ogLocale(lang)} />
        ))}
    <meta property="og:site_name" content={strings.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {schema.length > 0 && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(schema).replaceAll('<', '\\u003c')}
      />
    )}
  </head>
  <body>
    <a class="skip" href="#main">
      {strings.nav.skip}
    </a>
    <header class="site-header dark">
      <nav class="container nav" aria-label={strings.nav.label}>
        <a class="brand" href={home}>
          <svg
            class="brand-mark"
            aria-hidden="true"
            focusable="false"
            width="26"
            height="26"
            viewBox="0 0 26 26"
          >
            <rect width="26" height="26" rx="7" fill="currentColor" />
            <rect
              x="5.5"
              y="5.5"
              width="15"
              height="9"
              rx="1.4"
              fill="#0a0a0a"
            />
            <rect
              x="5.5"
              y="16.5"
              width="9"
              height="2.2"
              rx="0.7"
              fill="#0a0a0a"
            />
            <rect
              x="16.2"
              y="16"
              width="4.3"
              height="4.3"
              rx="0.75"
              fill="#a9bcdf"
            />
          </svg>
          {strings.brand}
        </a>
        <div class="nav-links">
          {navLinks.map(([label, hash]) => (
            <a href={navHref(hash)}>{label}</a>
          ))}
        </div>
        {RELEASED.languages && (
          <details class="language-menu">
            <summary aria-label={strings.nav.language}>
              <Icon name="globe" />
              <span lang={locale}>{strings.languageNames[locale]}</span>
            </summary>
            <ul>
              {languageOptions.map(
                ({ lang, url }) =>
                  lang !== 'x-default' && (
                    <li>
                      <a
                        href={url.pathname}
                        hreflang={lang}
                        lang={lang}
                        dir={dirFor(lang)}
                        aria-current={lang === locale ? 'page' : undefined}
                      >
                        {strings.languageNames[lang]}
                      </a>
                    </li>
                  ),
              )}
            </ul>
          </details>
        )}
        <a class="button button-light nav-follow" href={REPO_URL}>
          {strings.nav.follow}
        </a>
        <details class="nav-menu">
          <summary aria-label={strings.nav.menu}>
            <Icon name="menu" />
          </summary>
          <ul>
            {navLinks.map(([label, hash]) => (
              <li>
                <a href={navHref(hash)}>{label}</a>
              </li>
            ))}
            <li>
              <a href={REPO_URL}>{strings.nav.follow}</a>
            </li>
          </ul>
        </details>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer dark">
      <div class="container">
        <nav aria-label={strings.footer.label}>
          <a class="brand" href={home}>
            {strings.brand}
          </a>
          <ul>
            <li>
              <a href={localizedPath(locale, 'privacy')}>
                {strings.footer.privacy}
              </a>
            </li>
            <li>
              <a href={sitePath('changelog/')}>{strings.footer.changelog}</a>
            </li>
            <li>
              <a href={REPO_URL}>{strings.footer.github}</a>
            </li>
            <li>
              <a href="https://tanziro.com/">{strings.footer.site}</a>
            </li>
          </ul>
        </nav>
        <p>
          {strings.footer.credit}{' '}
          <a href="https://tanziro.com/">{strings.footer.site}</a>
          {strings.footer.inspired}{' '}
          <a href="https://frame.zibon.design/">{strings.footer.zibon}</a>
        </p>
      </div>
    </footer>
  </body>
</html>
